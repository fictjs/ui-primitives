{
  "name": "@fictjs/alert-dialog",
  "version": "0.3.1",
  "description": "Alert dialog primitives for Fict UI primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "fict",
    "radix",
    "alert-dialog",
    "ui-primitives"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictjs/ui-primitives.git",
    "directory": "packages/alert-dialog"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf coverage dist",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fictjs/compose-refs": "workspace:*",
    "@fictjs/context": "workspace:*",
    "@fictjs/core-primitive": "workspace:*",
    "@fictjs/dialog": "workspace:*",
    "@fictjs/slot": "workspace:*",
    "@fictjs/use-layout-effect": "workspace:*"
  },
  "peerDependencies": {
    "@fictjs/runtime": ">=0.32.0"
  },
  "devDependencies": {
    "@fictjs/runtime": "catalog:",
    "jsdom": "catalog:"
  }
}
