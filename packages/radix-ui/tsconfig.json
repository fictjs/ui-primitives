{
  "extends": "../../tsconfig.library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@fictjs/runtime",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@fictjs/accessible-icon": ["../accessible-icon/src/index.tsx"],
      "@fictjs/accordion": ["../accordion/src/index.ts"],
      "@fictjs/alert-dialog": ["../alert-dialog/src/index.ts"],
      "@fictjs/arrow": ["../arrow/src/index.tsx"],
      "@fictjs/aspect-ratio": ["../aspect-ratio/src/index.tsx"],
      "@fictjs/avatar": ["../avatar/src/index.tsx"],
      "@fictjs/checkbox": ["../checkbox/src/index.tsx"],
      "@fictjs/collapsible": ["../collapsible/src/index.tsx"],
      "@fictjs/collection": ["../collection/src/index.ts"],
      "@fictjs/compose-refs": ["../compose-refs/src/index.ts"],
      "@fictjs/context": ["../context/src/index.ts"],
      "@fictjs/context-menu": ["../context-menu/src/index.ts"],
      "@fictjs/core-primitive": ["../core-primitive/src/index.ts"],
      "@fictjs/dialog": ["../dialog/src/index.ts"],
      "@fictjs/direction": ["../direction/src/index.ts"],
      "@fictjs/dismissable-layer": ["../dismissable-layer/src/index.tsx"],
      "@fictjs/dropdown-menu": ["../dropdown-menu/src/index.ts"],
      "@fictjs/focus-guards": ["../focus-guards/src/index.tsx"],
      "@fictjs/focus-scope": ["../focus-scope/src/index.tsx"],
      "@fictjs/form": ["../form/src/index.ts"],
      "@fictjs/hover-card": ["../hover-card/src/index.ts"],
      "@fictjs/label": ["../label/src/index.tsx"],
      "@fictjs/menu": ["../menu/src/index.ts"],
      "@fictjs/menubar": ["../menubar/src/index.ts"],
      "@fictjs/navigation-menu": ["../navigation-menu/src/index.ts"],
      "@fictjs/one-time-password-field": ["../one-time-password-field/src/index.ts"],
      "@fictjs/password-toggle-field": ["../password-toggle-field/src/index.ts"],
      "@fictjs/popover": ["../popover/src/index.ts"],
      "@fictjs/popper": ["../popper/src/index.ts"],
      "@fictjs/portal": ["../portal/src/index.tsx"],
      "@fictjs/presence": ["../presence/src/index.tsx"],
      "@fictjs/primitive": ["../primitive/src/index.tsx"],
      "@fictjs/progress": ["../progress/src/index.tsx"],
      "@fictjs/radio-group": ["../radio-group/src/index.ts"],
      "@fictjs/radix-ui": ["./src/index.ts"],
      "@fictjs/radix-ui/internal": ["./src/internal.ts"],
      "@fictjs/roving-focus": ["../roving-focus/src/index.tsx"],
      "@fictjs/scroll-area": ["../scroll-area/src/index.ts"],
      "@fictjs/select": ["../select/src/index.ts"],
      "@fictjs/separator": ["../separator/src/index.tsx"],
      "@fictjs/slider": ["../slider/src/index.ts"],
      "@fictjs/slot": ["../slot/src/index.tsx"],
      "@fictjs/switch": ["../switch/src/index.tsx"],
      "@fictjs/tabs": ["../tabs/src/index.ts"],
      "@fictjs/toast": ["../toast/src/index.ts"],
      "@fictjs/toggle": ["../toggle/src/index.tsx"],
      "@fictjs/toggle-group": ["../toggle-group/src/index.ts"],
      "@fictjs/toolbar": ["../toolbar/src/index.ts"],
      "@fictjs/tooltip": ["../tooltip/src/index.ts"],
      "@fictjs/use-callback-ref": ["../use-callback-ref/src/index.ts"],
      "@fictjs/use-controllable-state": ["../use-controllable-state/src/index.ts"],
      "@fictjs/use-effect-event": ["../use-effect-event/src/index.ts"],
      "@fictjs/use-escape-keydown": ["../use-escape-keydown/src/index.ts"],
      "@fictjs/use-is-hydrated": ["../use-is-hydrated/src/index.ts"],
      "@fictjs/use-layout-effect": ["../use-layout-effect/src/index.ts"],
      "@fictjs/use-size": ["../use-size/src/index.ts"],
      "@fictjs/visually-hidden": ["../visually-hidden/src/index.tsx"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist"]
}
