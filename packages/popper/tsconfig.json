{
  "extends": "../../tsconfig.library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@fictjs/runtime",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@fictjs/popper": ["./src/index.ts"],
      "@fictjs/arrow": ["../arrow/src/index.tsx"],
      "@fictjs/compose-refs": ["../compose-refs/src/index.ts"],
      "@fictjs/context": ["../context/src/index.ts"],
      "@fictjs/floating-ui-dom": ["../../libs/floating-ui-dom/src/index.ts"],
      "@fictjs/primitive": ["../primitive/src/index.tsx"],
      "@fictjs/rect": ["../rect/src/index.ts"],
      "@fictjs/use-callback-ref": ["../use-callback-ref/src/index.ts"],
      "@fictjs/use-layout-effect": ["../use-layout-effect/src/index.ts"],
      "@fictjs/use-size": ["../use-size/src/index.ts"],
      "@fictjs/runtime": ["../../../packages/runtime/dist/index.d.ts"],
      "@fictjs/runtime/advanced": ["../../../packages/runtime/dist/advanced.d.ts"],
      "@fictjs/runtime/jsx-runtime": ["../../../packages/runtime/dist/jsx-runtime.d.ts"],
      "@fictjs/runtime/jsx-dev-runtime": ["../../../packages/runtime/dist/jsx-dev-runtime.d.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist"]
}
