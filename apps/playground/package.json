{
  "name": "@fictjs/radix-ui-themes-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --dir ../.. --filter @fictjs/radix-ui-themes... --filter '!@fictjs/one-time-password-field' --filter '!@fictjs/password-toggle-field' build",
    "dev": "pnpm build:deps && vite --host 0.0.0.0 --port 3100",
    "dev:e2e": "pnpm build:deps && vite --host 127.0.0.1 --port 3110 --strictPort",
    "build": "pnpm build:deps && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4100",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "pnpm build:deps && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fictjs/radix-ui": "workspace:*",
    "@fictjs/radix-ui-themes": "workspace:*",
    "@fictjs/runtime": "catalog:",
    "fict": "^0.23.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@fictjs/vite-plugin": "^0.23.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "^7.3.1"
  }
}
