{
  "name": "@fictjs/fict-style-singleton",
  "version": "0.1.0",
  "description": "Style singleton utilities for Fict components.",
  "keywords": [
    "fict",
    "style",
    "singleton",
    "css",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictjs/ui-primitives.git",
    "directory": "libs/fict-style-singleton"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf coverage dist",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "get-nonce": "^1.0.1"
  },
  "peerDependencies": {
    "fict": "^0.17.0"
  },
  "devDependencies": {
    "fict": "^0.17.0",
    "jsdom": "^28.1.0"
  }
}
