{
  "extends": "../../tsconfig.library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "fict",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@fictjs/fict-remove-scroll": ["./src/index.ts"],
      "@fictjs/fict-remove-scroll/UI": ["./src/UI.tsx"],
      "@fictjs/fict-remove-scroll/sidecar": ["./src/sidecar.tsx"],
      "@fictjs/fict-remove-scroll-bar": ["../fict-remove-scroll-bar/src/index.ts"],
      "@fictjs/fict-remove-scroll-bar/constants": ["../fict-remove-scroll-bar/src/constants.ts"],
      "@fictjs/fict-style-singleton": ["../fict-style-singleton/src/index.ts"],
      "@fictjs/use-callback-ref": ["../../packages/use-callback-ref/src/index.ts"],
      "@fictjs/use-sidecar": ["../use-sidecar/dist/index.d.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist"]
}
