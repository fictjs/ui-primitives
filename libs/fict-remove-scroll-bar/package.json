{
  "name": "@fictjs/fict-remove-scroll-bar",
  "version": "0.1.0",
  "description": "Removes body scroll in Fict without layout shake.",
  "keywords": [
    "fict",
    "scroll",
    "scroll-lock",
    "body-lock",
    "ui-primitives"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    }
  },
  "files": [
    "dist",
    "constants",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictjs/ui-primitives.git",
    "directory": "libs/fict-remove-scroll-bar"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf coverage dist example-dist",
    "dev": "tsup --watch",
    "example:build": "vite build --config ./vite.config.ts",
    "example:dev": "vite --config ./vite.config.ts",
    "example:preview": "vite preview --config ./vite.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fictjs/fict-style-singleton": "workspace:*"
  },
  "peerDependencies": {
    "fict": "^0.22.0"
  },
  "devDependencies": {
    "@fictjs/runtime": "^0.22.0",
    "@fictjs/vite-plugin": "^0.22.0",
    "fict": "^0.22.0",
    "jsdom": "^28.1.0",
    "vite": "^7.3.1"
  }
}
