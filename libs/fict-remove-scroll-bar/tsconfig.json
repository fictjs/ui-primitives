{
  "extends": "../../tsconfig.library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "fict",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@fictjs/fict-remove-scroll-bar": ["./src/index.ts"],
      "@fictjs/fict-style-singleton": ["../fict-style-singleton/src/index.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "example/**/*.ts",
    "example/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist"]
}
