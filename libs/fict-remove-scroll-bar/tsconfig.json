{
  "extends": "../../packages/tsconfig/library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "fict",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "fict": ["../../../packages/fict/dist/index.d.ts"],
      "fict/jsx-runtime": ["../../../packages/fict/dist/jsx-runtime.d.ts"],
      "fict/jsx-dev-runtime": ["../../../packages/fict/dist/jsx-dev-runtime.d.ts"],
      "fict/advanced": ["../../../packages/fict/dist/advanced.d.ts"],
      "@fictjs/fict-style-singleton": ["../fict-style-singleton/src/index.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist"]
}
