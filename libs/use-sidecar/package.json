{
  "name": "@fictjs/use-sidecar",
  "version": "0.2.0",
  "description": "Sidecar code-splitting utilities for Fict components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "fict": {
    "metadata": "./dist/index.fict.meta.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictjs/ui-primitives.git",
    "directory": "libs/use-sidecar"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fict-metadata.mjs emit .",
    "clean": "rimraf coverage dist",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@fictjs/runtime": ">=0.23.0"
  },
  "devDependencies": {
    "@fictjs/runtime": "catalog:",
    "jsdom": "catalog:"
  }
}
