{
  "extends": "../../packages/tsconfig/library.json",
  "compilerOptions": {
    "incremental": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@fictjs/runtime",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules"]
}
