{
  "extends": "../../tsconfig.library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "jsxImportSource": "fict",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@fictjs/radix-ui": ["../../packages/radix-ui/src/index.ts"],
      "@fictjs/radix-ui/internal": ["../../packages/radix-ui/src/internal.ts"],
      "@fictjs/radix-ui-themes": ["./src/index.ts"],
      "@fictjs/radix-ui-themes/helpers": ["./src/helpers/index.ts"],
      "@fictjs/radix-ui-themes/props": ["./src/props/index.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "coverage",
    "dist",
    "layout",
    "tokens",
    "styles.css",
    "components.css",
    "utilities.css",
    "tokens.css",
    "layout.css"
  ]
}
